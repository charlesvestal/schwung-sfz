{
  "title": "Multisampler",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Plays multisample",
        "instruments from SFZ",
        "and DecentSampler",
        "sample libraries.",
        "",
        "Pianos, keys, drums,",
        "strings, brass - any",
        "recorded instrument",
        "shipped as an SFZ or",
        ".dspreset library.",
        "",
        "Velocity layers, round",
        "robin, key switching,",
        "loops, release samples",
        "all supported.",
        "",
        "Upload library folders",
        "to add more sounds."
      ]
    },
    {
      "title": "Getting Started",
      "children": [
        {
          "title": "Finding Libraries",
          "lines": [
            "Free SFZ libraries:",
            "",
            "sfzinstruments.",
            "  github.io",
            "",
            "Free synth packs:",
            "",
            "drolez.com /blog/",
            "  music",
            "",
            "DecentSampler libs:",
            "",
            "pianobook.co.uk",
            "",
            "decentsamples.com"
          ]
        },
        {
          "title": "Uploading",
          "lines": [
            "Use the Move web",
            "uploader to copy",
            "library folders to",
            "the Multisample slot.",
            "",
            "Each folder you",
            "upload",
            "appears as one",
            "instrument in the",
            "preset browser.",
            "",
            "Libraries can be very",
            "large (GB-scale).",
            "Loading is streamed",
            "so they fit on Move."
          ]
        },
        {
          "title": "Library Layout",
          "lines": [
            "On-device path:",
            "",
            " instruments /",
            "",
            "Two layouts work:",
            "",
            "1) Folder per library:",
            "  MyPiano /",
            "   piano.sfz",
            "   Samples /*.wav",
            "",
            "  Multiple .sfz files",
            "  in a folder become",
            "  variants (presets).",
            "",
            "2) Loose .sfz files:",
            "  Bell.sfz",
            "  Bell Samples /",
            "   *.wav",
            "",
            "  Each .sfz file is",
            "  its own instrument."
          ]
        }
      ]
    },
    {
      "title": "Playing",
      "children": [
        {
          "title": "Browsing",
          "lines": [
            "Jog wheel scrolls",
            "the flat preset list",
            "across all libraries.",
            "",
            "Shift + L / R jumps",
            "to the next or",
            "previous library's",
            "first preset.",
            "",
            "Pads play notes with",
            "full velocity",
            "sensitivity."
          ]
        },
        {
          "title": "Knobs (Live Row)",
          "lines": [
            "Octave:",
            " Shift all notes",
            " up or down by",
            " octaves.",
            " Range -4 to +4.",
            "",
            "Gain:",
            " Master output level.",
            " 0 to 2 (double).",
            " Default 0.7.",
            "",
            "Knobs 3-8:",
            " Per-library macros",
            " (DecentSampler",
            " knob bindings).",
            " Vary per preset."
          ]
        },
        {
          "title": "Voice Count",
          "lines": [
            "Voices:",
            " Polyphony cap.",
            " 4 to 128 notes.",
            " Default 14.",
            "",
            "Higher = more notes",
            "at once, more CPU.",
            "",
            "Sustain-pedal-held",
            "passages need more",
            "voices than the",
            "chord size suggests."
          ]
        }
      ]
    },
    {
      "title": "MIDI",
      "lines": [
        "Notes:",
        " Velocity-sensitive,",
        " 0 to 127.",
        "",
        "Pitch bend:",
        " Range per SFZ",
        " library definition.",
        "",
        "Aftertouch:",
        " Channel and poly.",
        "",
        "All CCs forwarded",
        "to library mappings",
        "(volume, sustain,",
        "expression, etc.).",
        "",
        "Program change:",
        " Switches preset."
      ]
    },
    {
      "title": "Troubleshooting",
      "children": [
        {
          "title": "No Sound",
          "lines": [
            "Check the library",
            "folder contains both",
            ".sfz / .dspreset",
            "and sample audio",
            "(WAV or FLAC).",
            "",
            "Error text in the",
            "preset browser shows",
            "load problems.",
            "",
            "'Sample not found'",
            "means audio files",
            "are missing from the",
            "folder.",
            "",
            "'0 regions' means",
            "the library parsed",
            "but no samples were",
            "mapped to keys."
          ]
        },
        {
          "title": "Missing Library",
          "lines": [
            "Folder must be",
            "inside the",
            "instruments / path.",
            "",
            "Folder must contain",
            "at least one",
            ".sfz or .dspreset",
            "file (can be in a",
            "subfolder up to",
            "5 levels deep)."
          ]
        },
        {
          "title": "Audio Glitches",
          "lines": [
            "First note after",
            "loading may have a",
            "brief delay as",
            "samples page in.",
            "Self-resolves.",
            "",
            "Very large chord",
            "bursts on heavy",
            "libraries can",
            "exceed CPU. Reduce",
            "voice count or",
            "polyphony.",
            "",
            "Long sample tails",
            "with non-zero",
            "endings get an",
            "automatic edge",
            "fade to suppress",
            "click."
          ]
        }
      ]
    },
    {
      "title": "About",
      "lines": [
        "Multisampler",
        "for Schwung.",
        "",
        "Uses the xsynth core",
        "engine with disk",
        "streaming, voice-side",
        "sample rate",
        "conversion, and",
        "anti-alias playback.",
        "",
        "Free and open source.",
        "LGPL-3.0 license."
      ]
    }
  ]
}
