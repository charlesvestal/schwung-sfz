{
  "id": "sfz",
  "name": "Multisampler",
  "abbrev": "MSP",
  "version": "0.6.0",
  "description": "Multisample instrument player for SFZ and DecentSampler libraries — pianos, keys, drums, orchestral, and more.",
  "author": "charlesvestal",
  "license": "LGPL-3.0",
  "ui": "ui.js",
  "dsp": "dsp.so",
  "api_version": 2,
  "capabilities": {
    "audio_out": true,
    "audio_in": false,
    "midi_in": true,
    "midi_out": true,
    "aftertouch": true,
    "chainable": true,
    "component_type": "sound_generator",
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Multisample",
          "params": [
            {
              "key": "preset",
              "label": "Instrument",
              "type": "int",
              "min": 0,
              "max_param": "preset_count",
              "default": 0
            },
            {
              "key": "octave_transpose",
              "label": "Octave",
              "type": "int",
              "min": -4,
              "max": 4,
              "default": 0
            },
            {
              "key": "gain",
              "label": "Gain",
              "type": "float",
              "min": 0,
              "max": 2,
              "default": 0.7
            },
            {
              "key": "funverb",
              "label": "Funverb",
              "type": "float",
              "min": 0,
              "max": 1,
              "default": 0.0
            },
            {
              "key": "voices",
              "label": "Voices",
              "type": "int",
              "min": 4,
              "max": 128,
              "default": 14
            },
            {
              "key": "knob_preset",
              "label": "Knob Preset",
              "type": "int",
              "min": 0,
              "max": 7,
              "default": 0
            }
          ],
          "knobs": [
            "knob_0",
            "knob_1",
            "knob_2",
            "knob_3",
            "knob_4",
            "knob_5",
            "knob_6",
            "knob_7"
          ]
        }
      }
    }
  },
  "assets": {
    "path": "instruments",
    "label": "Sample Libraries",
    "extensions": [
      ".sfz",
      ".dspreset"
    ],
    "description": "Upload SFZ or DecentSampler sample libraries. Either folders containing .sfz/.dspreset files plus sample audio, or loose .sfz files with samples in an adjacent folder.",
    "hint": "Find free sample libraries at",
    "hint_url": "https://sfzinstruments.github.io/",
    "hint_url_label": "SFZ Instruments"
  },
  "defaults": {
    "preset": 0
  }
}
