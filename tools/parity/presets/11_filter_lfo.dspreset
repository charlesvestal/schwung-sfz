<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler pluginVersion="1">
  <ui width="400" height="100"><tab/></ui>
  <groups attack="0" decay="0" sustain="1" release="0">
    <group>
      <sample path="../samples/noise_long.wav" rootNote="60" loNote="0" hiNote="127" loVel="0" hiVel="127"/>
    </group>
  </groups>
  <effects>
