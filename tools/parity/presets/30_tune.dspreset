<DecentSampler pluginVersion="1">
  <ui width="400" height="100"><tab/></ui>
  <groups attack="0" decay="0" sustain="1" release="0">
    <group>
      <!-- DS `tuning` is in semitones (fractional ok). The test name
           "minus50" refers to 50 cents (= -0.5 semitones), matching the
           expected magnitude of a fine-tune detune test. -->
      <sample path="../samples/sine_long.wav" rootNote="60" loNote="0" hiNote="127" loVel="0" hiVel="127" tuning="-0.5"/>
    </group>
  </groups>
</DecentSampler>
